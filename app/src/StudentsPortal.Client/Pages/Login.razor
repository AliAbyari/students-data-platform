@page "/login"
@attribute [AllowAnonymous]
@layout BlankLayout
@inherits PortalPage

<PageTitle>@L["login_title"] · @L["app_name"]</PageTitle>

<div class="auth">
    <section class="auth-hero" dir="@L.Dir">
        <div class="auth-wave" aria-hidden="true"></div>
        <div class="auth-features">
            <h2>@L["features_title"]</h2>
            <ul>
                @for (var i = 1; i <= 6; i++)
                {
                    <li><span class="auth-check"><Icon Name="check" Size="15" /></span><span>@L["feature_" + i]</span></li>
                }
            </ul>
        </div>
        <svg class="auth-illustration" viewBox="0 0 260 230" aria-hidden="true">
            <defs>
                <linearGradient id="shieldFill" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#5b8df2" /><stop offset="1" stop-color="#1f4fc4" />
                </linearGradient>
                <linearGradient id="shieldEdge" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#cfe0ff" /><stop offset="1" stop-color="#8fb2f7" />
                </linearGradient>
            </defs>
            <ellipse cx="70" cy="196" rx="62" ry="26" fill="#ffffff" opacity=".85" />
            <ellipse cx="190" cy="200" rx="54" ry="22" fill="#ffffff" opacity=".8" />
            <ellipse cx="130" cy="206" rx="80" ry="18" fill="#ffffff" opacity=".9" />
            <path d="M130 22 196 46v58c0 44-28 78-66 92-38-14-66-48-66-92V46Z" fill="url(#shieldEdge)" />
            <path d="M130 36 184 56v48c0 36-23 64-54 76-31-12-54-40-54-76V56Z" fill="url(#shieldFill)" />
            <ellipse cx="130" cy="112" rx="104" ry="30" fill="none" stroke="#ffffff" stroke-width="5" opacity=".8" transform="rotate(-14 130 112)" />
            <rect x="106" y="98" width="48" height="40" rx="8" fill="#ffffff" />
            <path d="M115 98V88a15 15 0 0 1 30 0v10" fill="none" stroke="#ffffff" stroke-width="7" />
            <circle cx="130" cy="114" r="6" fill="#2452c8" /><rect x="127" y="116" width="6" height="12" rx="3" fill="#2452c8" />
        </svg>
    </section>

    <section class="auth-side" dir="@L.Dir">
        <div class="auth-tools">
            <div class="toggle">
                <button class="@(L.IsFa ? "on" : "")" @onclick='() => Session.SetLanguageAsync("fa")'>فارسی</button>
                <button class="@(L.IsFa ? "" : "on")" @onclick='() => Session.SetLanguageAsync("en")'>English</button>
            </div>
            <button class="btn sm ghost icon-only" @onclick="ToggleTheme" aria-label="@L["theme"]" title="@L["theme"]">
                <Icon Name="@(Session.Theme == "dark" ? "sun" : "moon")" Size="16" />
            </button>
        </div>

        <h1 class="auth-heading">@L["login_heading"]</h1>

        <div class="auth-card">
            <div class="auth-logo">
                <img src="icon-512.png" alt="@L["app_name"]" width="132" height="132" />
                <div class="auth-logo-name">@L["app_name"]</div>
            </div>

            <form @onsubmit="SignIn" @onsubmit:preventDefault>
                <label class="field-icon">
                    <span class="visually-hidden">@L["username"]</span>
                    <Icon Name="user" Size="20" />
                    <input class="input" @bind="username" autocomplete="username" autofocus placeholder="@L["username"]" dir="ltr" />
                </label>
                <label class="field-icon">
                    <span class="visually-hidden">@L["password"]</span>
                    <button type="button" class="field-icon-btn" @onclick="() => showPassword = !showPassword"
                            aria-label="@(showPassword ? L["hide_password"] : L["show_password"])" title="@(showPassword ? L["hide_password"] : L["show_password"])">
                        <Icon Name="@(showPassword ? "eye-off" : "eye")" Size="20" />
                    </button>
                    <input class="input" type="@(showPassword ? "text" : "password")" @bind="password" autocomplete="current-password"
                           placeholder="@L["password"]" dir="ltr" />
                </label>

                <label class="switch">
                    <input type="checkbox" @bind="remember" />
                    <span class="switch-track"><span class="switch-thumb"></span></span>
                    <span>@L["keep_signed_in"]</span>
                </label>

                <button class="btn primary auth-submit" type="submit" disabled="@Busy">
                    @if (Busy) { <span class="spinner"></span> }
                    @L["sign_in"]
                </button>
            </form>
            <div class="auth-version">v1.0.0</div>
        </div>
    </section>
</div>

@code {
    private string username = "";
    private string password = "";
    private bool showPassword;
    private bool remember = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Session.User is not null && Session.Token is not null) Nav.NavigateTo("", replace: true);
    }

    private async Task SignIn()
    {
        var ok = await RunAsync(async () =>
        {
            var response = await Api.PostAsync<LoginResponse>("api/auth/login", new LoginRequest(username, password));
            var language = L.Language;
            var theme = Session.Theme;
            await Session.SignInAsync(response, remember, language, theme);
            if (response.User.PreferredLanguage != language || response.User.PreferredTheme != theme)
            {
                var u = response.User;
                try
                {
                    var updated = await Api.PutAsync<UserProfile>("api/profile",
                        new UpdateProfileRequest(u.FirstName, u.LastName, u.Email, language, theme));
                    await Session.UpdateUserAsync(updated);
                }
                catch (ApiException)
                {
                }
            }
            Session.JustSignedIn = true;
        });
        if (ok) Nav.NavigateTo("", replace: true);
    }

    private Task ToggleTheme() => Session.SetThemeAsync(Session.Theme == "dark" ? "light" : "dark");
}
