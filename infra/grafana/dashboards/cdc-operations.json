        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT quantile(0.95)(end_to_end_ms) FROM (SELECT end_to_end_ms FROM cdc_event_log ORDER BY processed_at DESC LIMIT 100) HAVING count() > 0",
          "refId": "A"
