    {
      "id": 4,
      "title": "Last successful batch",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-dw"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toUnixTimestamp64Milli(max(run_finished_at)) FROM rpt_pipeline_runs WHERE pipeline = 'batch_scd' AND has_failure = 0 AND arrayExists(s -> s.2 = 'fact.application', steps) HAVING count() > 0",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "fixed",
            "fixedColor": "#d9772f"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "CDC events per minute by table",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-dw"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfMinute(processed_at) AS time, source_table, count() AS events FROM cdc_event_log WHERE $__timeFilter(processed_at) GROUP BY time, source_table ORDER BY time",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No change events in the selected range. Edit a record in the portal to generate one."
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "End-to-end latency (commit to warehouse)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-dw"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfMinute(processed_at) AS time, avg(end_to_end_ms) AS avg_ms, quantile(0.95)(end_to_end_ms) AS p95_ms FROM cdc_event_log WHERE $__timeFilter(processed_at) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No change events in the selected range. Edit a record in the portal to generate one.",
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
