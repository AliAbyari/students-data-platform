        "uid": "clickhouse-dw"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT rule_name, table_name, severity, failed_rows, passed FROM dq_result WHERE batch_id = (SELECT max(batch_id) FROM dq_result) ORDER BY passed, severity, rule_name",
