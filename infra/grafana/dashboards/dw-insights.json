          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sumIf(f.enrollment_count, g.grade_code = 'A') AS A, sumIf(f.enrollment_count, g.grade_code = 'B') AS B, sumIf(f.enrollment_count, g.grade_code = 'C') AS C, sumIf(f.enrollment_count, g.grade_code = 'D') AS D, sumIf(f.enrollment_count, g.grade_code = 'F') AS F, sumIf(f.enrollment_count, g.grade_code = 'W') AS W FROM v_fact_enrollment AS f INNER JOIN v_dim_grade AS g ON g.grade_key = f.grade_key",
