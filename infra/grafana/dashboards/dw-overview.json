    {
      "id": 5,
      "title": "Course enrollments by term",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-dw"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT any(t.term_name) AS term, sum(f.enrollment_count) AS enrollments FROM v_fact_enrollment AS f INNER JOIN v_dim_term AS t ON t.term_key = f.term_key WHERE f.term_key > 0 GROUP BY f.term_key ORDER BY f.term_key",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "never",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -45
      }
    },
    {
      "id": 6,
      "title": "GPA by department",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-dw"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT d.department_name AS department, round(toFloat64(sum(f.quality_points)) / nullIf(toFloat64(sum(f.gpa_credits)), 0), 2) AS gpa FROM v_fact_enrollment AS f INNER JOIN v_dim_department AS d ON d.department_key = f.department_key GROUP BY department ORDER BY gpa DESC",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 4,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 7,
      "title": "Seat fill rate by department (%)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-dw"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT department_name AS department, round(100 * sum(enrolled) / nullIf(sum(capacity), 0), 1) AS fill_rate FROM rpt_course_offering_fill WHERE department_name != '' GROUP BY department ORDER BY fill_rate DESC",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 8,
      "title": "Applications vs admissions by entry year",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-dw"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toString(calendar_year) AS year, sum(application_count) AS applications, sum(admitted_count) AS admitted, sum(enrolled_count) AS enrolled FROM rpt_admissions WHERE calendar_year > 0 GROUP BY calendar_year ORDER BY calendar_year",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "never",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -45
      }
    },
    {
      "id": 9,
      "title": "Grade distribution",
      "type": "piechart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-dw"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT g.grade_code AS grade, count() AS enrollments FROM v_fact_enrollment AS f INNER JOIN v_dim_grade AS g ON g.grade_key = f.grade_key GROUP BY grade ORDER BY grade",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "id": 10,
      "title": "Students by census region and status",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-dw"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-dw"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT census_region AS region, countIf(student_status_code = 'A') AS active, countIf(student_status_code = 'G') AS graduated, countIf(student_status_code = 'W') AS withdrawn, count() AS total FROM v_dim_student WHERE student_key > 0 GROUP BY region ORDER BY total DESC",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
